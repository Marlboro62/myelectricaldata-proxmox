{
  "name": "MyElectricalData",
  "slug": "myelectricaldata",
  "categories": [
    16
  ],
  "date_created": "2026-10-07",
  "type": "ct",
  "updateable": true,
  "privileged": false,
  "interface_port": 8100,
  "documentation": "https://github.com/MyElectricalData/myelectricaldata_new/tree/main/docs/local-client",
  "website": "https://www.v2.myelectricaldata.fr/",
  "repository": "https://github.com/MyElectricalData/myelectricaldata_new",
  "platforms": [
    "pve"
  ],
  "logo": null,
  "description": "Local client for the MyElectricalData gateway: imports Linky smart meter data from Enedis APIs and exports it to Home Assistant, MQTT or VictoriaMetrics.",
  "install_methods": [
    {
      "type": "default",
      "script": "ct/myelectricaldata.sh",
      "config_path": "/opt/myelectricaldata/.env",
      "resources": {
        "cpu": 2,
        "ram": 2048,
        "hdd": 8,
        "os": "Debian",
        "version": "13"
      }
    }
  ],
  "default_credentials": {
    "username": null,
    "password": null
  },
  "notes": [
    {
      "text": "API credentials can be changed in /opt/myelectricaldata/.env, then run: systemctl restart myelectricaldata",
      "type": "info"
    }
  ],
  "app_vars": [
    {
      "name": "var_med_client_id",
      "label": "MyElectricalData Client ID",
      "type": "text",
      "required": true
    },
    {
      "name": "var_med_client_secret",
      "label": "MyElectricalData Client Secret",
      "type": "password",
      "secret": true,
      "required": true
    }
  ]
}
